# i 表示片段可在句中被触发。默认是只有在前面有多个空格或者在行首时才会被触发。
# A 表示片段会被自动触发
# w 表示片段只会在关键词为单独单词的情况下被触发
# r 表示关键词使用正则表达式。正则表达式必须用 两个引号' '包围
# b 表示只有在一行的开头才会被触发
#=================================================================================================

priority 100
snippet def "#define ..."
/*! ${2: brief description} */
#define $1
endsnippet

priority 100
snippet ifndef "#ifndef ... #define ... #endif"
#ifndef ${1:SYMBOL}
#define $1 ${2:value}
#endif /* ifndef $1 */
$0
endsnippet

priority 100
snippet if "#if #endif"
#if ${1:0}
${2:VISUAL}
#endif
$0
endsnippet

priority 100
snippet for "for loop"
for (${2:i} = 0; $2 < ${1:count}; ${3:++$2}) {
	${VISUAL}$0
}
endsnippet

priority 100
snippet fori "for int loop"
for (${4:int} ${2:i} = 0; $2 < ${1:count}; ${3:++$2}) {
	${VISUAL}$0
}
endsnippet


priority 100
snippet once "Include header once only guard"
#ifndef ${1:`!p
if not snip.c:
	import random, string, os
	path = os.getcwd()
	spiltPath=re.findall(".*\/(.*)\/(.*)$",path)[0]
	dir1= re.sub(r'[^A-Za-z0-9]+','_', spiltPath[0]).upper()
	dir2= re.sub(r'[^A-Za-z0-9]+','_', spiltPath[1]).upper()
	name = re.sub(r'[^A-Za-z0-9]+','_', snip.fn).upper()
	#rand = ''.join(random.sample(string.ascii_letters+string.digits, 8))
	snip.rv = ('%s_%s_%s' % (dir1,dir2,name)).upper()
else:
	snip.rv = snip.c`}
#define $1

${VISUAL}$0

#endif /* end of include guard: $1 */
endsnippet


priority 100
snippet eli "else if .. "
else if (${1:/* condition */}) {
	${VISUAL}$0
}
endsnippet


priority 100
snippet Inc "include <>" b
#include <${1:name.hpp}>
$0
endsnippet

priority 100
snippet main "with args" b
int main(int argc, char *argv[])
{
	${VISUAL}$0
	return 0;
}
endsnippet

#=================================================================================================
# doxygen相关
priority 100
snippet cc "C++注释(非doxygen)" i
/*
  ${1:${VISUAL}}
*/
$0
endsnippet

priority 100
snippet dex "example (doxygen)" b
/*! \example ${1:`!p  snip.rv = "test_"+snip.basename`}.c${2:pp}
 *  ${3:brief description}
 */$0
endsnippet

priority 100
snippet dh "head (doxygen)"
/*! \file `!p snip.rv = fn`
 *  \author Zhao Chengpeng
 *  \date `!v strftime("%Y-%m-%d")`
 *  \version ${1:1.0.0}
 *  \brief ${2:brief description}
 *  \copyright Copyright © 2021 zhaoCp. All Rights Reserved.
 *  \liense GNU General Public License version 3.0 (GPL v3.0）
 */$0
endsnippet

priority 100
snippet dr "func related with a class (doxygen)"
/*! \relates ${1:className}
 *  ${2:brief description}
 */$0
endsnippet

priority 100
snippet db "inline brief description (doxygen)"
/*! ${1:brief description} */$0
endsnippet

priority 100
snippet dfv "void function(args) (doxygen)"
/*! ${1:function description}
 *  \param[${2:in,out}] ${3:parName} ${4:parameter description}
 */$0
endsnippet

priority 100
snippet df "function(args) (doxygen)"
/*! ${1:function description}
 *  \param[${2:in,out}] ${3:parName} ${4:parameter description}
 *  \return ${5:parName} ${6:parameter description}
 */$0
endsnippet

priority 100
snippet dt "templated type (doxygen)"
/*! ${1:brief description}
 *  \tparam ${3:T} ${4:parameter description}
 */$0
endsnippet
